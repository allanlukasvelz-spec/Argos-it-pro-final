PORT=4000
NODE_ENV=production

# Lista separada por comas: todos los orígenes desde los que el navegador llama al API
# Debe coincidir con la URL pública del frontend (con y sin www, previews, etc.)
CORS_ORIGINS=https://argos-it.com,https://www.argos-it.com

# URL del frontend (algunas rutas del backend pueden usarla en enlaces)
FRONTEND_URL=https://argos-it.com

# Opcional: misma URL base del API que usa el frontend (documentacion / despliegues unificados)
# NEXT_PUBLIC_BACKEND_URL=https://api.argos-it.com


# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# JWT secrets (minimo 32 caracteres)
JWT_SECRET=REEMPLAZAR_POR_SECRETO_LARGO_Y_ALEATORIO
JWT_REFRESH_SECRET=REEMPLAZAR_POR_SECRETO_LARGO_Y_ALEATORIO

# Socket.IO: false para no exponer WebSockets (menor superficie si no hay cliente)
# ENABLE_SOCKET_IO=true

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Opcional: longitud maxima del mensaje en endpoints de chat (caracteres)
AI_MESSAGE_MAX_LEN=6000

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=8
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_RATE_LIMIT_MAX=5

# Contact form relay (optional)
CONTACT_FORM_ENDPOINT=https://formspree.io/f/xpqooedl

LOG_LEVEL=info
