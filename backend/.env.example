# =============================================================================
# Backend — copia a backend/.env (ignorado por Git). No uses secretos reales aquí.
# Staging: configura en el proveedor. Generar JWT: openssl rand -hex 48 (×2, distintos).
# =============================================================================

PORT=4000
NODE_ENV=production

# Orígenes del navegador que llaman al API (coma-separados). ≠ URL interna de DB.
# Local: http://localhost:3000
# Staging: https://staging.argos-it.com
CORS_ORIGINS=https://argos-it.com,https://www.argos-it.com

# URL pública del frontend (enlaces / referencias). Misma idea que CORS en single-origin.
FRONTEND_URL=https://argos-it.com

# PostgreSQL — cadena privada. En Docker Compose el backend usa host `db`.
# Local host (override :5433): postgresql://postgres:PASS@127.0.0.1:5433/argos_it
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# JWT: DEBEN ser distintos entre sí y ≥32 caracteres (ideal openssl rand -hex 48)
JWT_SECRET=REEMPLAZAR_POR_SECRETO_ACCESS_LARGO_Y_ALEATORIO
JWT_REFRESH_SECRET=REEMPLAZAR_POR_SECRETO_REFRESH_DISTINTO_Y_ALEATORIO

# false = no montar Socket.IO (recomendado sin cliente WS real)
ENABLE_SOCKET_IO=false

# Public ARGOS assistant + legacy mascot chat (vacío → 503 assistant_unavailable)
# AI_PROVIDER=openai|none  (default: openai when OPENAI_API_KEY set, else none)
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=45000
AI_MESSAGE_MAX_LEN=2000
AI_MAX_OUTPUT_TOKENS=700
AI_CONVERSATION_MAX_MESSAGES=12
AI_CONVERSATION_TTL_MS=1800000
AI_CONVERSATION_MAX_TOTAL=500

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=8
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_RATE_LIMIT_MAX=5

CONTACT_FORM_ENDPOINT=https://formspree.io/f/xpqooedl

LOG_LEVEL=info

# Platform foundation (optional; unset = no-op telemetry / no evidence store)
# OTEL_EXPORTER_OTLP_ENDPOINT=
# ARGOS_PLATFORM_TELEMETRY_LOG=0
# ENABLE_MONITOR_SCHEDULER=true
# ARGOS_ALLOW_RATE_LIMIT_RESET=0
# ARGOS_EVIDENCE_ROOT=/var/lib/argos/evidence
# ARGOS_EVIDENCE_MAX_BYTES=10485760
# ARGOS_EVIDENCE_QUOTA_BYTES=0
