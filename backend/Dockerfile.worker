# Phase 8 worker image — includes Playwright Chromium for real PDF rendering.
# Chromium exception: may require --no-sandbox in container (see reportPdfRenderer).
ARG NODE_IMAGE=node:22.14.0-bookworm-slim@sha256:1c18d9ab3af4585870b92e4dbc5cac5a0dc77dd13df1a5905cea89fc720eb05b
FROM ${NODE_IMAGE}

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system argos && useradd --system --gid argos --create-home argos

COPY package*.json ./
RUN npm ci --omit=dev && npm install playwright@1.59.1 --no-save \
  && npx playwright install chromium

COPY . .

RUN chown -R argos:argos /app /home/argos
USER argos

ENV ARGOS_WORKER_HEARTBEAT_PATH=/tmp/argos-worker-heartbeat

# No EXPOSE — worker has no inbound port
HEALTHCHECK --interval=20s --timeout=5s --start-period=60s --retries=5 \
  CMD node -e "const fs=require('fs');const p=process.env.ARGOS_WORKER_HEARTBEAT_PATH||'/tmp/argos-worker-heartbeat';try{const t=Number(fs.readFileSync(p,'utf8'));process.exit(Date.now()-t<60000?0:1)}catch(e){process.exit(1)}"

CMD ["node", "worker.js"]
