# =============================================================================
# Plantilla versionada para crear docker/.env, que es SOLO local y está ignorado.
# Copia: cp docker/.env.example docker/.env
# Generar secretos: openssl rand -hex 48
# =============================================================================

# Password de PostgreSQL en la red Docker (servicio `db`)
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_DB_LOCAL_FUERTE

# JWT: deben ser distintos entre sí y ≥32 caracteres (ideal: openssl rand -hex 48)
JWT_SECRET=
JWT_REFRESH_SECRET=

# OpenAI opcional en local (vacío = IA responde 503 assistant_unavailable)
OPENAI_API_KEY=

# false = no montar Socket.IO (recomendado si no hay cliente WS real)
ENABLE_SOCKET_IO=false

# Puertos publicados en el host
FRONTEND_PORT=3000
BACKEND_PORT=4000
# Postgres: no se publica en docker-compose.yml; usa override local (5433) si necesitas psql desde el host
