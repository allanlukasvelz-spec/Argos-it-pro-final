# ARGOS staging env template — copy to docker/.env.staging (gitignored).
# NEVER commit real secrets.
#
#   cp docker/.env.staging.example docker/.env.staging

# --- Postgres ---
STAGING_POSTGRES_DB=argos_staging
STAGING_POSTGRES_USER=argos_staging
STAGING_POSTGRES_PASSWORD=CHANGE_ME_staging_pg_password_32chars

# --- Auth (must differ from each other, >=32 chars) ---
STAGING_JWT_SECRET=CHANGE_ME_staging_jwt_access_secret_min_32
STAGING_JWT_REFRESH_SECRET=CHANGE_ME_staging_jwt_refresh_secret_min_32

# --- MinIO (private staging object store) ---
STAGING_MINIO_ROOT_USER=argos_staging_minio
STAGING_MINIO_ROOT_PASSWORD=CHANGE_ME_staging_minio_password_32
STAGING_MINIO_BUCKET=argos-evidence-staging
STAGING_MINIO_API_PORT=9020
STAGING_MINIO_CONSOLE_PORT=9021

# --- Host publishes (localhost only in compose) ---
STAGING_API_PORT=4010
STAGING_FRONTEND_PORT=3010
STAGING_FRONTEND_URL=http://127.0.0.1:3010
STAGING_CORS_ORIGINS=http://127.0.0.1:3010

LOG_LEVEL=info
ARGOS_WORKER_POLL_MS=2000

# --- Fail-closed: leave EMPTY / unset in staging ---
# ARGOS_ALLOW_RATE_LIMIT_RESET=
# ARGOS_REPORT_PDF_STUB=
# ALLOW_NOC_SELF_APPROVAL=
# ARGOS_MINIO_POC=
