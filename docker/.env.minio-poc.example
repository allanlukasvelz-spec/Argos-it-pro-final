# LOCAL/TEST ONLY — copy to docker/.env.minio-poc (gitignored). Do NOT commit real secrets.
# Generate passwords: openssl rand -base64 24

MINIO_ROOT_USER=argos-minio-poc
MINIO_ROOT_PASSWORD=change-me-minio-poc-local-only
MINIO_BUCKET=argos-evidence-poc
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend (when ARGOS_EVIDENCE_STORE=s3) — host → MinIO published on localhost
ARGOS_EVIDENCE_STORE=s3
ARGOS_EVIDENCE_S3_ENDPOINT=http://127.0.0.1:9000
ARGOS_EVIDENCE_S3_BUCKET=argos-evidence-poc
ARGOS_EVIDENCE_S3_ACCESS_KEY=argos-minio-poc
ARGOS_EVIDENCE_S3_SECRET_KEY=change-me-minio-poc-local-only
ARGOS_EVIDENCE_S3_REGION=us-east-1
ARGOS_EVIDENCE_S3_FORCE_PATH_STYLE=true
