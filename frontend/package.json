    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "@types/react": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.2.2"
  },
  "overrides": {
    "postcss": "^8.5.10"
