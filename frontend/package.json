{
  "name": "argos-frontend",
  "version": "2.0.0",
  "description": "Frontend Next.js para Argos IT Pro",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:docker": "next dev --hostname 0.0.0.0 --port 3000",
