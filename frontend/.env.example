# Copia a .env.local y ajusta valores (Next.js carga NEXT_PUBLIC_* en el cliente)

# URL base del API (obligatorio para chat mascotas y llamadas autenticadas desde el navegador)
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:4000
# NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Opcional: URL pública del sitio (p. ej. enlaces absolutos u OG en evoluciones futuras; hoy metadataBase suele ir en layout)
# NEXT_PUBLIC_SITE_URL=https://argos-it.com
