# Copia a frontend/.env.local (ignorado por Git). Next.js carga NEXT_PUBLIC_* en el cliente.
#
# Local: apunta al API en el host (Docker publica 4000 o BACKEND_PORT).
# Staging: URL pública del API accesible desde el navegador (HTTPS).
#   NEXT_PUBLIC_BACKEND_URL=https://api-staging.argos-it.com
# No uses db, backend, localhost ni 127.0.0.1 como URL pública de staging.

# BACKEND_URL: solo servidor (route handlers / proxy mascot-chat).
# NEXT_PUBLIC_BACKEND_URL: también visible en el navegador (lib/api.ts).
BACKEND_URL=http://127.0.0.1:4000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:4000

# Opcional: URL pública del sitio (metadata / OG futuros)
# NEXT_PUBLIC_SITE_URL=https://argos-it.com

NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=https://formspree.io/f/xpqooedl
