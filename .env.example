# =============================================================================
# Plantilla documental (raíz). Next.js carga .env.local desde frontend/;
# el backend carga variables desde backend/.env o el entorno del proceso.
# No commitees secretos reales.
# =============================================================================

# --- Backend (API Node) ---
PORT=4000
NODE_ENV=production

# PostgreSQL (obligatorio para arrancar backend/server.js)
DATABASE_URL=postgresql://usuario:password@host:5432/argos_it

# JWT (mínimo 32 caracteres cada uno)
JWT_SECRET=cambiar_por_un_secreto_largo_de_32_caracteres_minimo
JWT_REFRESH_SECRET=cambiar_por_otro_secreto_largo_de_32_caracteres

# Socket.IO: false desactiva WebSockets (por defecto en código: activo si no se define)
# ENABLE_SOCKET_IO=true

# OpenAI (vacío = IA pública responde 503 assistant_unavailable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=45000
# Longitud máxima mensajes IA (backend/lib/aiMessage.js)
AI_MESSAGE_MAX_LEN=6000

# CORS y URL del sitio que llama al API (lista separada por comas en CORS_ORIGINS)
FRONTEND_URL=https://tudominio.com
BACKEND_URL=https://api.tudominio.com
CORS_ORIGINS=https://tudominio.com,https://www.tudominio.com

# --- Frontend (NEXT_PUBLIC_* inyectadas en build/runtime del cliente) ---
NEXT_PUBLIC_BACKEND_URL=https://api.tudominio.com
# Opcional: URL pública del sitio para futuros enlaces absolutos / OG (no referenciada aún en todo el código)
# NEXT_PUBLIC_SITE_URL=https://tudominio.com

# Relay opcional de contacto en backend (routes/contact.js, client.js)
CONTACT_FORM_ENDPOINT=https://formspree.io/f/xpqooedl

# --- Rate limits (backend/middleware/security.js) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=8
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_RATE_LIMIT_MAX=5

# Logs (LOG_LEVEL=silent reduce log de detección de bots en security.js)
LOG_LEVEL=info
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=https://formspree.io/f/xpqooedl
