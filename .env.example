# =============================================================================
# Plantilla documental (raíz). No commitees secretos reales.
#
# Local:
#   - Backend: copia backend/.env.example → backend/.env
#   - Frontend: copia frontend/.env.example → frontend/.env.local
#   - Docker: copia docker/.env.example → docker/.env
#
# Staging / producción:
#   Configura las variables en el proveedor (Vercel, Railway, VPS, etc.).
#   Genera JWT: openssl rand -hex 48  (dos veces, valores distintos)
#   JWT_SECRET y JWT_REFRESH_SECRET DEBEN ser distintos y ≥ 32 bytes.
# =============================================================================

# --- Backend (API Node) ---
PORT=4000
NODE_ENV=production

# PostgreSQL (obligatorio). No uses localhost/db como URL pública de staging.
# Local Docker (desde el host con override :5433): postgresql://postgres:PASS@127.0.0.1:5433/argos_it
# Red Docker interna (servicio backend): postgresql://postgres:PASS@db:5432/argos_it
# Staging: cadena privada del proveedor (nunca en Git).
DATABASE_URL=postgresql://usuario:password@host:5432/argos_it

# JWT — distintos entre sí; mínimo 32 caracteres; staging: openssl rand -hex 48
JWT_SECRET=cambiar_por_un_secreto_largo_de_32_caracteres_minimo
JWT_REFRESH_SECRET=cambiar_por_otro_secreto_largo_de_32_caracteres_distinto

# Socket.IO: false desactiva WebSockets (recomendado si no hay cliente WS real)
ENABLE_SOCKET_IO=false

# OpenAI (vacío = IA pública responde 503 assistant_unavailable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=45000
AI_MESSAGE_MAX_LEN=6000

# FRONTEND_URL = sitio público (enlaces). CORS_ORIGINS = orígenes del navegador al API.
# Staging ejemplo (sustituir por dominios reales):
#   FRONTEND_URL=https://staging.argos-it.com
#   CORS_ORIGINS=https://staging.argos-it.com
FRONTEND_URL=https://tudominio.com
CORS_ORIGINS=https://tudominio.com,https://www.tudominio.com

# --- Frontend (NEXT_PUBLIC_* inyectadas en build/runtime del cliente) ---
# Debe ser la URL del API accesible desde el navegador del usuario (no "db", "backend", ni 127.0.0.1 en staging).
# Staging ejemplo: NEXT_PUBLIC_BACKEND_URL=https://api-staging.argos-it.com
NEXT_PUBLIC_BACKEND_URL=https://api.tudominio.com

# Relay opcional de contacto en backend
CONTACT_FORM_ENDPOINT=https://formspree.io/f/xpqooedl

# --- Rate limits (backend/middleware/security.js) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=8
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_RATE_LIMIT_MAX=5

# Logs (LOG_LEVEL=silent reduce log de detección de bots)
LOG_LEVEL=info

# Frontend Formspree directo (opcional; ContactView)
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=https://formspree.io/f/xpqooedl
